# Kopieren nach .env und ausfüllen. Die Datei .env niemals committen oder teilen.

# Login-Passwort für den Vault Browser
VAULT_PASSWORD=bitte-ändern
# Zufallswert, z.B. erzeugt mit: openssl rand -hex 32
SESSION_SECRET=

# GitLab: Projekt -> Settings -> Access tokens, Rolle "Developer",
# Berechtigungen read_repository + write_repository
GIT_REMOTE=https://oauth2:DEIN_TOKEN@gitlab.example.com/ich/vault.git
GIT_BRANCH=main
# Abstand zwischen zwei Abgleichen in Sekunden
SYNC_INTERVAL=120

# Woher die Oberfläche geladen wird (ohne Pfad)
ALLOWED_ORIGINS=https://atoxien.github.io
