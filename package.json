{
  "name": "vault-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian-Vaults im Browser lesen und bearbeiten – aus einem lokalen Ordner, vom eigenen Server oder direkt aus Obsidian. Ohne Installation auf fremden Rechnern nutzbar.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm start -w server",
    "test": "npm test -w web && npm test -w server"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "notes",
    "self-hosted",
    "vault",
    "pkm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Atoxien/obsidian-browserui.git"
  },
  "homepage": "https://atoxien.github.io/obsidian-browserui/"
}
